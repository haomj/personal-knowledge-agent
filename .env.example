# 复制为 .env 后填入真实值；不要把 .env 提交到 git。
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-flash
LLM_TEMPERATURE=0.7
LLM_THINKING=disabled
LOG_LEVEL=INFO

# Day 2: Embedding / RAG
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
DOCS_DIR=data/docs
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=knowledge_base
RAG_TOP_K=4
RAG_MAX_RETRIES=1

# Day 5: Web research
TAVILY_API_KEY=your-tavily-api-key

# Day 3: Memory / persistence
CHECKPOINT_DB=data/checkpoints.sqlite
MEMORY_DB=data/memory.sqlite
DEFAULT_USER=local-user
REPORTS_DIR=data/reports

# Day 8/9: Web Runtime
WEB_HOST=127.0.0.1
WEB_PORT=8000
# 留空表示本地不启用认证；公网/演示环境请设置强随机 Token。
WEB_AUTH_TOKEN=

# Docker Desktop 可选代理：容器内访问宿主机代理。
# 例如 host 使用 127.0.0.1:7897 时，填 http://host.docker.internal:7897
DOCKER_HTTP_PROXY=
DOCKER_NO_PROXY=localhost,127.0.0.1
